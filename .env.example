# Garmin Connect Credentials (Optional, or prompt interactively)
GARMIN_EMAIL=your_email@example.com
GARMIN_PASSWORD=your_password

# Custom token directory (defaults to ~/.garminconnect_tokens)
GARMIN_TOKEN_DIR=./garmin_tokens

# Gemini API Key (Required for AI storytelling and diary generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Web UI Configuration
WEB_ADMIN_PASSWORD=admin123

# MemReport App Integration
MEMREPORT_URL=http://192.168.2.41:8125/memreport
MEMREPORT_USER=admin
MEMREPORT_PASSWORD=admin123

# Output Directory (defaults to ./today)
OUTPUT_DIR=today
